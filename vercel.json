{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.circleuponline.com"
        }
      ],
      "destination": "https://circleuponline.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "circleup-swart.vercel.app"
        }
      ],
      "destination": "https://circleuponline.com/:path*",
      "permanent": true
    }
  ],
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "src/server.ts",
      "buildCommand": "npm --prefix .. run build --workspace=@circleup/shared && npm run build"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm --prefix .. run build --workspace=@circleup/shared && npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/(.*\\..*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    }
  ]
}
