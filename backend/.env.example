NODE_ENV=development
PORT=5001

# ==============================================================================
# 🌿 CircleUp MongoDB Database Configuration
# ==============================================================================
# Paste your MongoDB connection string below:
#
# • MongoDB Atlas (Cloud - Recommended):
#   MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/circleup?retryWrites=true&w=majority
#
# • Local MongoDB Community Server:
#   MONGODB_URI=mongodb://127.0.0.1:27017/circleup_dev
# ==============================================================================
MONGODB_URI=mongodb://127.0.0.1:27017/circleup_dev

# JWT Secrets (minimum 32 characters)
JWT_ACCESS_SECRET=replace-with-32-plus-char-customer-access-secret
JWT_ADMIN_ACCESS_SECRET=replace-with-32-plus-char-admin-access-secret
JWT_ACCESS_TTL=15m
JWT_ADMIN_ACCESS_TTL=10m

# Cookies & CORS
COOKIE_DOMAIN=localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend Base URL (for verification/reset email links)
FRONTEND_URL=http://localhost:5173

# Cloudinary (M2+)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional Email (M1+)
EMAIL_API_KEY=
EMAIL_FROM=noreply@circleup.in

# Internal Scheduled Jobs Secret (M4/M5+)
CRON_SECRET=replace-with-cron-secret

# Observability
LOG_LEVEL=info
SENTRY_DSN=
