NODE_ENV=development
PORT=5001

# ==============================================================================
# 🌿 CircleUp MongoDB Database Configuration
# ==============================================================================
# Paste your MongoDB connection string below:
#
# • MongoDB Atlas (Cloud - Recommended):
#   MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/circleup?retryWrites=true&w=majority
#
# • Local MongoDB Community Server:
#   MONGODB_URI=mongodb://127.0.0.1:27017/circleup_dev
# ==============================================================================
MONGODB_URI=mongodb://127.0.0.1:27017/circleup_dev

# JWT & Session Secrets (minimum 32 characters)
JWT_ACCESS_SECRET=replace-with-32-plus-char-customer-access-secret
JWT_ADMIN_ACCESS_SECRET=replace-with-32-plus-char-admin-access-secret
JWT_ACCESS_TTL=15m
JWT_ADMIN_ACCESS_TTL=10m
# Admin Session HMAC Signing Secret (required >= 32 chars in production)
SESSION_SECRET=replace-with-32-plus-char-admin-session-signing-key

# ==============================================================================
# Supabase Authentication (Customer JWT Verification)
# ==============================================================================
# • Required for HS256 symmetric signing (from Supabase Project Settings -> API -> JWT Secret):
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret-from-dashboard
# • Optional for asymmetric signing (RS256/ES256) / remote user verification:
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Cookies & CORS
COOKIE_DOMAIN=localhost
CORS_ALLOWED_ORIGINS=https://circleuponline.com,https://www.circleuponline.com,http://localhost:5173

# Frontend Base URL (for verification/reset email links)
FRONTEND_URL=https://circleuponline.com

# Cloudinary (M2+)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional Email (M1+)
EMAIL_API_KEY=
EMAIL_FROM=noreply@circleup.in

# Razorpay integration foundation only; the checkout UI stays disabled until the
# initiation, verification, webhook, persistence, and audit lifecycle is completed.
# Use a Razorpay TEST key only. Do not put live keys here.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Storage Adapter (local | s3)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Internal Scheduled Jobs Secret (M4/M5+)
CRON_SECRET=replace-with-cron-secret

# Observability
LOG_LEVEL=info
SENTRY_DSN=
